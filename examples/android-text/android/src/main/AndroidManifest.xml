<?xml version="1.0" encoding="utf-8"?>
<!-- RuneActivity is NativeActivity plus a view that takes the on-screen keyboard
     (crates/rune/android). It loads libandroid_text.so and calls its android_main. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:label="Rune text">
    <activity android:name="dev.rune.RuneActivity" android:exported="true"
        android:windowSoftInputMode="adjustNothing"
        android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density">
      <meta-data android:name="android.app.lib_name" android:value="android_text"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
